  "panels": [
    {
      "type": "stat",
      "title": "HTTP requests / sec (1m)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(dclaw_http_requests_total[1m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}}
    },
    {
      "type": "stat",
      "title": "4xx + 5xx rate (1m)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "expr": "sum(rate(dclaw_http_requests_total{status=~\"4..|5..\"}[1m]))",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 1}]}}}
    },
    {
      "type": "stat",
      "title": "AI calls (success, 5m)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(dclaw_ai_calls_total{outcome=\"success\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "ops"}}
    },
    {
      "type": "stat",
      "title": "Rate-limit blocks (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(increase(dclaw_rate_limit_blocks_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(dclaw_http_request_duration_seconds_bucket[5m])) by (le, route))",
        "legendFormat": "{{route}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "AI call p95 latency by service",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(dclaw_ai_call_duration_seconds_bucket[5m])) by (le, service))",
        "legendFormat": "{{service}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "LLM provider calls by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [{
        "expr": "sum(rate(dclaw_llm_provider_calls_total[5m])) by (provider, outcome)",
        "legendFormat": "{{provider}} / {{outcome}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{
        "expr": "sum(rate(dclaw_cache_events_total{event=\"hit\"}[5m])) / clamp_min(sum(rate(dclaw_cache_events_total{event=~\"hit|miss\"}[5m])), 0.001)",
        "legendFormat": "hit ratio",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    }
  ],
