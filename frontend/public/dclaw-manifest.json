{
  "app_id": "crisis",
  "name": "DClaw Crisis",
  "tagline": "Crisis response",
  "category": "Operations",
  "color": "#EC4899",
  "phase": "Future",
  "maturity_tier": "tier-3-production",
  "version": "2.0.0",
  "ports": {
    "frontend": 3079,
    "backend": 18149
  },
  "database": "dclaw_crisis",
  "api_base": "/api/v1",
  "health_endpoint": "/health",
  "routes": [
    { "path": "/", "label": "Landing" },
    { "path": "/dashboard", "label": "Command Center" },
    { "path": "/signals", "label": "Signals (Crisis Detection)" },
    { "path": "/crisis", "label": "Crises" },
    { "path": "/team", "label": "Team" },
    { "path": "/stakeholders", "label": "Stakeholders" },
    { "path": "/resources", "label": "Resources" },
    { "path": "/action-items", "label": "Action Items" },
    { "path": "/playbooks", "label": "Playbooks" },
    { "path": "/simulations", "label": "Simulations & Training" },
    { "path": "/media", "label": "Media Monitoring" },
    { "path": "/legal-holds", "label": "Legal Holds" }
  ],
  "ai_copilot": {
    "enabled": true,
    "endpoint": "/api/v1/copilot/chat",
    "providers": ["openrouter", "ollama"]
  },
  "features": {
    "p0": ["ai_crisis_copilot", "command_center", "response_planning", "crisis_detection"],
    "p1": ["communication_management", "post_crisis_review", "stakeholder_mapping", "resource_mobilization"],
    "p2": ["simulation_training", "continuity_integration", "media_monitoring", "legal_hold"]
  },
  "stack": {
    "frontend": "Next.js 14+",
    "backend": "FastAPI",
    "database": "PostgreSQL 16",
    "auth": "Logto"
  }
}
