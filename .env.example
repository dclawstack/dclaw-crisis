# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_crisis
APP_ENV=dev
DEBUG=true

# AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Auth
SECRET_KEY=change-me-in-production-this-needs-32-bytes-min
# Auth provider — "local" uses signin/signup with bcrypt + HS256 JWT.
# Set to "logto" once Logto credentials are configured (LOGTO_ENDPOINT etc.).
AUTH_PROVIDER=local
# Set to "true" to short-circuit auth for local dev only. NEVER in production.
AUTH_DISABLED=false
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:18149
