# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_crisis
APP_ENV=dev
DEBUG=true

# AI
# `localhost` works when the backend runs directly on the host.
# Inside Docker, docker-compose.yml overrides this to host.docker.internal
# (with `extra_hosts: host-gateway` for Linux compatibility).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Auth
SECRET_KEY=change-me-in-production-this-needs-32-bytes-min
# Auth provider — "local" uses signin/signup with bcrypt + HS256 JWT.
# Set to "logto" once Logto credentials are configured (LOGTO_ENDPOINT etc.).
AUTH_PROVIDER=local
# Set to "true" to short-circuit auth for local dev only. NEVER in production.
AUTH_DISABLED=false
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=

# Redis — caching, rate limiting, and idempotency keys.
REDIS_URL=redis://localhost:6389/0
# Set to "true" to skip Redis entirely (cache becomes pass-through, rate limit
# always allows, idempotency keys ignored). Used in tests.
REDIS_DISABLED=false
AI_RATE_LIMIT_PER_HOUR=60
AI_CACHE_TTL_SECONDS=600
SIGNALS_IDEMPOTENCY_TTL_SECONDS=3600

# MinIO — object storage for legal-hold notice + post-mortem exports.
# Set MINIO_DISABLED=true (or leave endpoint empty) to use the in-memory
# simulator with local pseudo-presigned URLs (good for dev + tests).
MINIO_ENDPOINT=localhost:9020
# When backend talks to MinIO over an internal hostname but browsers need a
# different host (e.g. dockerized stack), set the externally-reachable host
# here. Used only for presigned-URL signing; uploads still use MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=dclaw-crisis
MINIO_SECRET_KEY=change-me-in-production
MINIO_SECURE=false
MINIO_BUCKET=dclaw-crisis-exports
MINIO_DISABLED=false
MINIO_PRESIGN_SECONDS=3600

# Demo landing-page seeder. Off by default — production deployments leave
# this off so /api/v1/demo/{seed,reset} return 403. Flip to "true" for the
# in-app demo experience.
ENABLE_DEMO_MODE=false
DEMO_USER_EMAIL=demo@dclaw-crisis.example
DEMO_USER_PASSWORD=DemoPass123!
DEMO_USER_NAME=Demo Operator

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8061
